@model IEnumerable<ProjetoFinal.Models.Compra>

@{
    ViewData["Title"] = "Lista de Compras";
}

<div class="container my-4">
    <h2 class="mb-4">A Minha Lista de Compras</h2>
    <hr /><br />

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            Ainda não fez nenhuma compra.
        </div>
    }
    else
    {
        <div class="accordion" id="accordionCompras">
            @foreach (var compra in Model)
            {
                var collapseId = $"collapseCompra{compra.Id}";
                var headingId = $"headingCompra{compra.Id}";

                <div class="accordion-item mb-3 shadow-sm">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <div class="d-flex justify-content-between w-100 me-3">
                                <span><strong>Compra de @compra.DataCompra.ToString("dd/MM/yyyy HH:mm")</strong></span>
                                <span class="badge bg-secondary">Total de Bilhetes: @compra.Bilhetes.Count</span>
                            </div>
                        </button>
                    </h2>

                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#accordionCompras">
                        <div class="accordion-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped align-middle">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Filme</th>
                                            <th>Sessão</th>
                                            <th>Lugar</th>
                                            <th>Preço</th>
                                            <th>Estado</th>
                                            <th>
                                                @{
                                                    bool podeReembolsarTodos = compra.Bilhetes.Any() && compra.Bilhetes.All(b => b.Estado == EstadosBilhete.Pendente && b.Sessao.DataHora > DateTime.Now.AddHours(48));
                                                }

                                                @if (podeReembolsarTodos)
                                                {
                                                    <form asp-controller="Compras" asp-action="ReembolsarCompra" asp-route-id="@compra.Id" method="post">
                                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Pretende mesmo reembolsar todos os bilhetes desta compra?');">
                                                            Reembolsar Todos
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-danger btn-sm" disabled>
                                                        Reembolsar Todos
                                                    </button>
                                                }
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bilhete in compra.Bilhetes)
                                        {
                                            <tr>
                                                <td>@bilhete.Sessao?.Filme?.Titulo</td>
                                                <td>@bilhete.Sessao?.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@bilhete.Lugar.Fila@bilhete.Lugar.Numero</td>
                                                <td>@bilhete.TipoDeBilhete.Preco.ToString("C")</td>
                                                <td>
                                                    @if (bilhete.Estado == EstadosBilhete.Pendente)
                                                    {
                                                        <div style="color: orange;">Pendente</div>
                                                    }
                                                    else if (bilhete.Estado == EstadosBilhete.Concluido)
                                                    {
                                                        <div style="color: green;">Concluído</div>
                                                    }
                                                    else
                                                    {
                                                        <div style="color: blue;">Reembolsado</div>
                                                    }
                                                </td>
                                                <td>
                                                    @if (bilhete.Estado == EstadosBilhete.Pendente)
                                                    {
                                                        @if (bilhete.Sessao.DataHora > DateTime.Now.AddHours(48))
                                                        {
                                                            <form asp-controller="Bilhetes" asp-action="Reembolsar" asp-route-id="@bilhete.Id" method="post" style="display:inline;">
                                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Pretende mesmo solicitar o reembolso deste bilhete?');">
                                                                    Reembolsar
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small" title="Prazo limite de 48h ultrapassado">Prazo expirado</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">N/D</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}