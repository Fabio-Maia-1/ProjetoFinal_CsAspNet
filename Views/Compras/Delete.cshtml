@model ProjetoFinal.Models.Compra

@{
    ViewData["Title"] = "Apagar Compra";
}

<h1>Apagar Compra</h1>
<br />

<h4>Tem a certeza que pretende apagar esta compra?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Data da Compra</dt>
    <dd class="col-sm-10">@Model.DataCompra</dd>

    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@(Model.Cliente != null ? Model.Cliente.Nome : "-")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Apagar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
