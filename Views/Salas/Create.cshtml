@model ProjetoFinal.Models.Sala

@{
    ViewData["Title"] = "Criar Sala";
}

<h1>Criar Sala</h1>
<br />

<form asp-action="Create" method="post">

    <div class="form-group">
        <label asp-for="Nome" class="control-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NumeroFilas" class="control-label"></label>
        <input asp-for="NumeroFilas" class="form-control" />
        <span asp-validation-for="NumeroFilas" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LugaresPorFila" class="control-label"></label>
        <input asp-for="LugaresPorFila" class="form-control" />
        <span asp-validation-for="LugaresPorFila" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Estado" class="control-label"></label>
        <select asp-for="Estado" class="form-control" asp-items="Html.GetEnumSelectList<ProjetoFinal.Models.EstadosSala>()"></select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
    <br />

    <div class="form-group mt-3">
        <input type="submit" value="Criar" class="btn btn-primary" /><br /><br />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
