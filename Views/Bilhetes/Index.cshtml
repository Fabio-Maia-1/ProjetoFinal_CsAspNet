@model IEnumerable<ProjetoFinal.Models.Bilhete>

@{
    ViewData["Title"] = "Bilhetes";
}

<h1>Bilhetes</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Adicionar Novo Bilhete</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Estado</th>
            <th>Sessão</th>
            <th>Lugar</th>
            <th>Tipo</th>
            <th>Compra</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Estado</td>
            <td>@(item.Sessao != null ? item.Sessao.DataHora.ToString("g") : "-")</td>
            <td>@(item.Lugar != null ? (item.Lugar.Fila + item.Lugar.Numero) : "-")</td>
            <td>@(item.TipoDeBilhete != null ? item.TipoDeBilhete.Tipo : "-")</td>
            <td>@(item.CompraId)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">Detalhes</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
