@{
    ViewData["Title"] = "Home Page";
}

<style>
    

    
</style>

<form>

    <div class="text-center">
        <h2 class="display-4">@ViewBag.Cliente</h2>
    </div>

    <br />

    <div class="filmes-container">

        @foreach (var filme in ViewBag.Filmes)
        {
            <div class="filme-card">
                <img src=@filme.PosterPath alt=@filme.Titulo>
                <div class="filme-info">
                    <h4 style="color:white">@filme.Titulo</h4>
                    <p>Duração: @filme.Duracao min</p>
                </div>
                <a asp-action="Detalhes" asp-controller="Home" asp-route-id="@filme.Id" class="btn-comprar">Verificar Sessões</a>
            </div>
        }
    </div>

</form>

