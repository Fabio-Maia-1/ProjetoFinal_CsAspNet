@model ProjetoFinal.Models.Filme

@{
    ViewData["Title"] = "Indisponibilizar";
}

<h1>Indisponibilizar Filme</h1>
<br />

<h3>Quer indisponibilizar este Filme?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Model.Titulo</dd>

        <dt class="col-sm-2">Género</dt>
        <dd class="col-sm-10">@Model.Genero</dd>

        <dt class="col-sm-2">Duração</dt>
        <dd class="col-sm-10">@Model.Duracao</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Indisponibilizar" class="btn btn-danger" /><br /><br />
        <a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
    </form>
</div>
