@model ProjetoFinal.Models.Filme

@{
    ViewData["Title"] = "Delete Filme";
}

<h1>Delete Filme</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Filme</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Model.Titulo</dd>

        <dt class="col-sm-2">Género</dt>
        <dd class="col-sm-10">@Model.Genero</dd>

        <dt class="col-sm-2">Duração</dt>
        <dd class="col-sm-10">@Model.Duracao</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
