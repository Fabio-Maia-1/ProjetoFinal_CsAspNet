@model ProjetoFinal.Models.Filme

@{
    ViewData["Title"] = "Edit Filme";
}

<h1>Edit Filme</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Titulo" class="control-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Descricao" class="control-label"></label>
        <textarea asp-for="Descricao" class="form-control"></textarea>
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Duracao" class="control-label"></label>
        <input asp-for="Duracao" class="form-control" />
        <span asp-validation-for="Duracao" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Genero" class="control-label"></label>
        <select asp-for="Genero" class="form-control" asp-items="@Html.GetEnumSelectList<ProjetoFinal.Models.GenerosFilme>()"></select>
        <span asp-validation-for="Genero" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ClassificacaoEtaria" class="control-label"></label>
        <select asp-for="ClassificacaoEtaria" class="form-control" asp-items="@Html.GetEnumSelectList<ProjetoFinal.Models.classificacoesEtariasFilme>()"></select>
        <span asp-validation-for="ClassificacaoEtaria" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Poster Atual</label>
        <br />
        <img src="@Model.PosterPath"
             alt="@Model.Titulo"
             style="max-height: 250px;" />
    </div>

    <!-- Guardar poster original caso o user não o altere -->
    <input type="hidden" asp-for="PosterPath" />

    <div class="form-group">
        <label>Novo Poster</label>
        <input type="file" name="Poster" class="form-control" accept="image/*" />
    </div>

    <div class="form-group ">
        <label asp-for="Disponivel" class="form-check-label"></label>
        <input asp-for="Disponivel" class="form-check-input" style="width: 26px;" />
    </div>

    <br /><br /><br />

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" /><br /><br />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
