@model ProjetoFinal.Models.Filme

@{
    ViewData["Title"] = "Filme Details";
}

<h1>Filme Details</h1>

<div>
    <h4>Filme</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Model.Titulo</dd>

        <dt class="col-sm-2">Descrição</dt>
        <dd class="col-sm-10">@Model.Descricao</dd>

        <dt class="col-sm-2">Duração</dt>
        <dd class="col-sm-10">@Model.Duracao</dd>

        <dt class="col-sm-2">Género</dt>
        <dd class="col-sm-10">@Model.Genero</dd>

        <dt class="col-sm-2">Classificação Etária</dt>
        <dd class="col-sm-10">@Model.ClassificacaoEtaria</dd>

        <dt class="col-sm-2">Disponível</dt>
        <dd class="col-sm-10">@(Model.Disponivel ? "Yes" : "No")</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
