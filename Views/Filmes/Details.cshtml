@model ProjetoFinal.Models.Filme

@{
    ViewData["Title"] = "Detalhes do Filme";
}

<h1>Detalhes do Filme</h1>
<br />
<br />

<!--
    Explicação do col-xx-x: São classes do Bootstrap para definição de colunas.
    'sm' Aplica-se a ecrãs pequenos (como telemóveis) e continua ativo em ecrãs maiores (md, lg, xl).
    O número indica quantas colunas a div deve ocupar numa grade de 12 colunas. Por exemplo, 'col-sm-6' significa metade da largura.
    'md' é usado na divisão principal porque queremos que a imagem e os detalhes do filme fiquem lado a lado apenas em ecrãs médios e maiores.
-->
<div class="row">
    <div class="col-md-8">
        <h4 style="font-weight:bold">@Model.Titulo</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">@Model.Descricao</dd>

            <dt class="col-sm-3">Duração</dt>
            <dd class="col-sm-9">@Model.Duracao minutos</dd>

            <dt class="col-sm-3">Género</dt>
            <dd class="col-sm-9">@Model.Genero</dd>

            <dt class="col-sm-3">Classificação Etária</dt>
            <dd class="col-sm-9">@Model.ClassificacaoEtaria</dd>

            <dt class="col-sm-3">Disponível</dt>
            <dd class="col-sm-9">@(Model.Disponivel ? "Sim" : "Não")</dd>
        </dl>
    </div>

    <div class="col-md-4 text-center">
        <img src="@Model.PosterPath" alt="@Model.Titulo" class="img-fluid rounded shadow" style="max-height: 500px;" />
    </div>
</div>

<br />
<p class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <br /><br />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>