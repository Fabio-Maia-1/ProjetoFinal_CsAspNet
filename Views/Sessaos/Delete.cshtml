@model ProjetoFinal.Models.Sessao

@{
    ViewData["Title"] = "Apagar Sessão";
}

<h1>Apagar Sessão</h1>

<h3>Tem a certeza que pretende apagar esta sessão?</h3>

<div>
    <h4>Sessão</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Data e Hora</dt>
        <dd class="col-sm-10">@Model.DataHora.ToString("g")</dd>

        <dt class="col-sm-2">Filme</dt>
        <dd class="col-sm-10">@Model.Filme?.Titulo</dd>

        <dt class="col-sm-2">Sala</dt>
        <dd class="col-sm-10">@Model.Sala?.Nome</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Apagar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
