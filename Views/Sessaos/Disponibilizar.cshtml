@model ProjetoFinal.Models.Sessao

@{
    ViewData["Title"] = "Disponibilizar Sessão";
}

<h1>Disponibilizar Sessão</h1>
<br />

<h3>Tem a certeza que quer disponibilizar esta sessão aos clientes?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Data e Hora</dt>
        <dd class="col-sm-10">@Model.DataHora.ToString("g")</dd>

        <dt class="col-sm-2">Filme</dt>
        <dd class="col-sm-10">@Model.Filme?.Titulo</dd>

        <dt class="col-sm-2">Sala</dt>
        <dd class="col-sm-10">@Model.Sala?.Nome</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Estado</dd>
    </dl>

    <form asp-action="Disponibilizar" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Disponibilizar" class="btn btn-primary" /><br /><br />
        <a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
    </form>
</div>
