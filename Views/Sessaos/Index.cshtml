@model IEnumerable<ProjetoFinal.Models.Sessao>

@{
    ViewData["Title"] = "Sessoes";
}

<h1>Sessões</h1>
<br />

<p>
    <a asp-action="Create" class="btn btn-primary">Criar Sessão</a>
</p>

<div class="d-flex gap-2 mb-4">
    <a asp-action="Index" class="btn btn-secondary">Ver Todas</a>
    <a asp-action="Index" asp-route-estado="0" class="btn btn-primary">Ver Planeadas</a>
    <a asp-action="Index" asp-route-estado="1" class="btn btn-success">Ver Concluídas</a>
    <a asp-action="Index" asp-route-estado="2" class="btn btn-danger">Ver Canceladas</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Data e Hora</th>
            <th>Filme</th>
            <th>Sala</th>
            <th>Estado</th>
            <th>Detalhes</th>
            <th>Disponivilizar</th>
            <th>Cancelar</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.DataHora.ToString("g")</td>
            <td>@item.Filme?.Titulo</td>
            <td>@item.Sala?.Nome</td>
            <td>@item.Estado</td>
            <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">Detalhes</a></td>
            <td><a asp-action="Disponibilizar" asp-route-id="@item.Id" class="btn btn-primary @(item.Estado != EstadosSessao.EmPreparacao ? "disabled" : "")">Disponibilizar</a></td>
            <td><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger @(item.Estado == EstadosSessao.Cancelada || item.Estado == EstadosSessao.Concluida ? "disabled" : "")">Cancelar </a></td>
        </tr>
    }
    </tbody>
</table>
