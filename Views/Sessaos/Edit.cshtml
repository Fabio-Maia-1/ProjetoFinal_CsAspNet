@model ProjetoFinal.Models.Sessao

@{
    ViewData["Title"] = "Editar Sessão";
}

<h1>Editar Sessão</h1>
<br />

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="DataHora" class="control-label"></label>
        <input asp-for="DataHora" class="form-control" type="datetime-local" />
        <span asp-validation-for="DataHora" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FilmeId" class="control-label">Filme</label>
        <select asp-for="FilmeId" class="form-control" asp-items="@(ViewBag.FilmeId as SelectList)"></select>
        <span asp-validation-for="FilmeId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SalaId" class="control-label">Sala</label>
        <select asp-for="SalaId" class="form-control" asp-items="@(ViewBag.SalaId as SelectList)"></select>
        <span asp-validation-for="SalaId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Estado" class="control-label"></label>
        <select asp-for="Estado" class="form-control" asp-items="Html.GetEnumSelectList<ProjetoFinal.Models.EstadosSessao>()"></select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <br />

    <div class="form-group mt-3">
        <input type="submit" value="Guardar" class="btn btn-primary" /><br /><br />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
